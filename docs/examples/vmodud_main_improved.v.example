// cmd/vmodud/main_improved.v
// VModu Runtime v3.0 - Production Ready Implementation
// Integrates all improved modules with production-grade features

module main

import os
import time

// ═══════════════════════════════════════════════════════════════════════════
// Import improved modules
// ═══════════════════════════════════════════════════════════════════════════

// Phase 1: Critical Fixes
import vmodu.event.bus
import vmodu.infra.db
import vmodu.infra.logger
import vmodu.infra.health
import vmodu.agent.llm

// Phase 2: Core Features
import vmodu.cluster.raft.rpc
import vmodu.infra.pool

// Phase 3: Production Hardening
import vmodu.infra.metrics
import vmodu.infra.circuit
import vmodu.infra.trace

// Phase 4: Polish
import vmodu.config

// ═══════════════════════════════════════════════════════════════════════════
// Global System State
// ═══════════════════════════════════════════════════════════════════════════

struct SystemState {
mut:
	// Phase 1
	logger       &logger.Logger
	health_check &health.Checker
	event_bus    &bus.EventBus
	event_store  &db.PersistentLog
	llm_client   &llm.Client

	// Phase 2
	rpc_client   &rpc.Client
	conn_pool    &pool.Pool

	// Phase 3
	metrics_reg  &metrics.Registry
	cb_manager   &circuit.Manager
	tracer       &trace.Tracer

	// Phase 4
	config_mgr   &config.Manager

	// Status
	started_at   i64
	is_running   bool
}

// ═══════════════════════════════════════════════════════════════════════════
// System Initialization
// ═══════════════════════════════════════════════════════════════════════════

fn init_system() !&SystemState {
	mut state := &SystemState{
		started_at: time.now().unix_milli()
		is_running: true
	}

	// ═══════════════════════════════════════════════════════════════════════
	// 1. Initialize Logger First (for subsequent logging)
	// ═══════════════════════════════════════════════════════════════════════
	println('[INIT] Initializing structured logging...')

	logger.init_global_logger(logger.Config{
		level:         .info
		format:        .json
		output:        'stdout'
		add_timestamp: true
	})
	state.logger = logger.get_global_logger()
	state.logger.info('VModu Runtime v3.0 - Production Ready')

	// ═══════════════════════════════════════════════════════════════════════
	// 2. Load Configuration with Hot Reload
	// ═══════════════════════════════════════════════════════════════════════
	state.logger.info('Loading configuration...')

	mut cfg_mgr := config.new_manager()
	cfg_mgr.on_validate = fn (c config.Config) ! {
		config.validate(c)!
	}
	cfg_mgr.on_change = fn (c config.Config) ! {
		logger.info('Configuration reloaded dynamically')
	}

	// Try to load config, use defaults if not found
	if os.exists('config.json') {
		cfg_mgr.load('config.json')!
		cfg_mgr.start_watching() or {
			state.logger.warn('Failed to start config watcher: ${err}')
		}
	} else {
		state.logger.warn('No config.json found, using defaults')
		cfg_mgr.config = config.default()
	}

	state.config_mgr = cfg_mgr
	cfg := cfg_mgr.get()

	// ═══════════════════════════════════════════════════════════════════════
	// 3. Initialize Distributed Tracing
	// ═══════════════════════════════════════════════════════════════════════
	state.logger.info('Initializing distributed tracing...')

	exporter := trace.new_console_exporter(false)
	trace.init_global(cfg.cluster.node_id, exporter)
	state.tracer = trace.get_global()

	mut root_span := state.tracer.start_span('system_startup', trace.SpanOptions{})
	defer { root_span.end() }

	// ═══════════════════════════════════════════════════════════════════════
	// 4. Initialize Metrics (Prometheus-compatible)
	// ═══════════════════════════════════════════════════════════════════════
	state.logger.info('Initializing metrics collection...')

	state.metrics_reg = metrics.new_registry('vmodu')

	// Create key metrics
	mut actor_counter := state.metrics_reg.new_counter('actors_total', 'Total actors created', {})!
	mut msg_counter := state.metrics_reg.new_counter('messages_total', 'Total messages processed', {})!
	mut msg_duration := state.metrics_reg.new_histogram('message_duration_seconds', 'Message processing duration', {}, [])!
	mut active_gauge := state.metrics_reg.new_gauge('actors_active', 'Currently active actors', {})!

	actor_counter.inc()
	state.logger.info_with_fields('Metrics initialized', {
		'registry': 'vmodu'
		'counters': '2'
		'histograms': '1'
		'gauges': '1'
	})

	// ═══════════════════════════════════════════════════════════════════════
	// 5. Initialize Health Checks
	// ═══════════════════════════════════════════════════════════════════════
	state.logger.info('Initializing health check system...')

	mut health_checker := health.new_checker(health.CheckerConfig{
		check_interval_ms: 30000  // Check every 30s
	})

	// Register basic health checks
	health_checker.register('system', fn [state] () health.ComponentHealth {
		if state.is_running {
			return health.ComponentHealth{
				status:  .healthy
				message: 'System is running'
			}
		}
		return health.ComponentHealth{
			status:  .unhealthy
			message: 'System is not running'
		}
	})!

	health_checker.start_background_checks()
	state.health_check = health_checker
	state.logger.info('Health checks started')

	// ═══════════════════════════════════════════════════════════════════════
	// 6. Initialize Circuit Breaker Manager
	// ═══════════════════════════════════════════════════════════════════════
	state.logger.info('Initializing circuit breakers...')

	state.cb_manager = circuit.new_manager(circuit.Config{
		failure_threshold: 5
		timeout_ms:        30000
	})
	state.logger.info('Circuit breaker manager ready')

	// ═══════════════════════════════════════════════════════════════════════
	// 7. Initialize Event Store (Buffered I/O)
	// ═══════════════════════════════════════════════════════════════════════
	state.logger.info('Initializing event store with buffered I/O...')

	mut store := db.new_persistent_log(db.StoreConfig{
		data_dir:          cfg.storage.data_dir
		segment_size:      cfg.storage.segment_size
		buffer_size:       cfg.storage.buffer_size
		flush_interval_ms: cfg.storage.flush_interval_ms
		fsync_on_write:    cfg.storage.fsync_on_write
	})!

	state.event_store = store
	state.logger.info_with_fields('Event store initialized', {
		'data_dir': cfg.storage.data_dir
		'buffer_size': '${cfg.storage.buffer_size}'
		'fsync': '${cfg.storage.fsync_on_write}'
	})

	// Update health check with store
	health_checker.register('event_store', fn [state] () health.ComponentHealth {
		stats := state.event_store.get_stats()
		if stats.flush_errors < 10 {
			return health.ComponentHealth{
				status:  .healthy
				message: 'Writes: ${stats.writes_total}, Segments: ${stats.segments_rotated}'
			}
		}
		return health.ComponentHealth{
			status:  .degraded
			message: '${stats.flush_errors} flush errors'
		}
	})!

	// ═══════════════════════════════════════════════════════════════════════
	// 8. Initialize Thread-Safe Event Bus
	// ═══════════════════════════════════════════════════════════════════════
	state.logger.info('Initializing thread-safe event bus...')

	state.event_bus = bus.new_event_bus(bus.Config{
		max_subscribers_per_topic: 1000
		publish_timeout_ms:        5000
		buffer_size:               100
	})
	state.logger.info('Event bus initialized with mutex protection')

	// ═══════════════════════════════════════════════════════════════════════
	// 9. Initialize LLM Client (Real HTTP)
	// ═══════════════════════════════════════════════════════════════════════
	state.logger.info('Initializing LLM client...')

	llm_config := llm.Config{
		provider:      match cfg.llm.provider {
			'openai' { llm.Provider.openai }
			'anthropic' { llm.Provider.anthropic }
			else { llm.Provider.openai }
		}
		base_url:      if cfg.llm.provider == 'openai' { 'https://api.openai.com/v1' } else { 'https://api.anthropic.com/v1' }
		api_key:       cfg.llm.api_key
		model:         cfg.llm.model
		max_tokens:    cfg.llm.max_tokens
		temperature:   cfg.llm.temperature
		timeout_ms:    cfg.llm.timeout_ms
		max_retries:   cfg.llm.max_retries
		cache_enabled: true
		cache_ttl_ms:  3600000
	}

	state.llm_client = llm.new_client(llm_config)
	state.logger.info_with_fields('LLM client initialized', {
		'provider': cfg.llm.provider
		'model': cfg.llm.model
		'cache': 'enabled'
	})

	// ═══════════════════════════════════════════════════════════════════════
	// 10. Initialize Raft RPC Layer
	// ═══════════════════════════════════════════════════════════════════════
	state.logger.info('Initializing Raft RPC layer...')

	state.rpc_client = rpc.new_client(cfg.cluster.node_id, rpc.ClientConfig{
		dial_timeout_ms:    5000
		request_timeout_ms: 10000
		keep_alive:         true
	})

	// Add peers from config
	for peer_addr in cfg.cluster.peer_addresses {
		parts := peer_addr.split(':')
		if parts.len == 3 {
			state.rpc_client.add_peer(parts[0], parts[1], parts[2].int())
		}
	}
	state.logger.info('Raft RPC client initialized')

	// ═══════════════════════════════════════════════════════════════════════
	// Initialization Complete
	// ═══════════════════════════════════════════════════════════════════════
	root_span.set_ok()
	state.logger.info_with_fields('System initialization complete', {
		'duration_ms': '${time.now().unix_milli() - state.started_at}'
	})

	return state
}

// ═══════════════════════════════════════════════════════════════════════════
// Graceful Shutdown
// ═══════════════════════════════════════════════════════════════════════════

fn shutdown_system(mut state SystemState) {
	state.logger.info('Starting graceful shutdown...')
	mut span := state.tracer.start_span('system_shutdown', trace.SpanOptions{})
	defer { span.end() }

	state.is_running = false

	// 1. Stop accepting new work
	state.logger.info('Stopping health checks...')
	state.health_check.stop_watching() or {
		state.logger.error('Error stopping health checks: ${err}')
	}

	// 2. Flush event store
	state.logger.info('Flushing event store...')
	state.event_store.close() or {
		state.logger.error('Error closing event store: ${err}')
	}

	// 3. Close RPC connections
	state.logger.info('Closing RPC connections...')
	state.rpc_client.close()

	// 4. Stop config watcher
	state.logger.info('Stopping config watcher...')
	state.config_mgr.stop_watching() or {
		state.logger.error('Error stopping config watcher: ${err}')
	}

	span.set_ok()
	state.logger.info('Graceful shutdown complete')
	state.logger.close() or {}
}

// ═══════════════════════════════════════════════════════════════════════════
// HTTP Handlers for Health, Metrics, Config
// ═══════════════════════════════════════════════════════════════════════════

fn handle_health(state &SystemState) string {
	report := state.health_check.get_report()
	return report.to_http_response()
}

fn handle_metrics(state &SystemState) string {
	exporter := metrics.new_exporter(state.metrics_reg)
	return exporter.export()
}

// ═══════════════════════════════════════════════════════════════════════════
// Demo Operations
// ═══════════════════════════════════════════════════════════════════════════

fn demo_event_bus(mut state SystemState) {
	state.logger.info('=== Demo: Thread-Safe Event Bus ===')
	mut span := state.tracer.start_span('demo_event_bus', trace.SpanOptions{})
	defer { span.end() }

	// Subscribe to topic
	mut received := 0
	state.event_bus.subscribe('demo.topic', fn [mut received] (msg bus.Message) {
		received++
		logger.info('Received: ${msg.topic}')
	}) or {
		state.logger.error('Subscribe failed: ${err}')
		return
	}

	// Publish messages
	for i := 0; i < 5; i++ {
		state.event_bus.publish('demo.topic', 'payload-${i}'.bytes()) or {
			state.logger.error('Publish failed: ${err}')
		}
	}

	time.sleep(100 * time.millisecond)
	stats := state.event_bus.get_stats()

	state.logger.info_with_fields('Event bus demo complete', {
		'messages_published': '${stats.messages_published}'
		'messages_delivered': '${stats.messages_delivered}'
	})
	span.set_ok()
}

fn demo_event_store(mut state SystemState) {
	state.logger.info('=== Demo: Buffered Event Store ===')
	mut span := state.tracer.start_span('demo_event_store', trace.SpanOptions{})
	defer { span.end() }

	// Append events
	for i := 0; i < 100; i++ {
		offset := state.event_store.append('demo-stream', 'event-${i}') or {
			state.logger.error('Append failed: ${err}')
			continue
		}
		if i < 3 {
			state.logger.info('Appended event at offset ${offset}')
		}
	}

	// Force flush
	state.event_store.close() or {}

	stats := state.event_store.get_stats()
	state.logger.info_with_fields('Event store demo complete', {
		'total_writes': '${stats.writes_total}'
		'bytes_written': '${stats.bytes_written}'
		'segments_rotated': '${stats.segments_rotated}'
	})
	span.set_ok()
}

fn demo_circuit_breaker(mut state SystemState) {
	state.logger.info('=== Demo: Circuit Breaker ===')
	mut span := state.tracer.start_span('demo_circuit_breaker', trace.SpanOptions{})
	defer { span.end() }

	mut cb := state.cb_manager.get_or_create('demo-api')

	// Successful calls
	for i := 0; i < 3; i++ {
		result := cb.execute(fn () !string {
			return 'success'
		}) or {
			return
		}
		state.logger.info('Call ${i+1}: ${result}')
	}

	// Failed calls to trigger circuit
	for i := 0; i < 6; i++ {
		_ := cb.execute(fn () !string {
			return error('simulated failure')
		})
	}

	state := cb.get_state()
	state.logger.info('Circuit breaker state: ${state}')

	span.set_ok()
}

fn demo_metrics_export(state &SystemState) {
	state.logger.info('=== Demo: Prometheus Metrics ===')

	// Generate some metrics
	if counter := state.metrics_reg.counters['vmodu_actors_total'] {
		counter.inc()
		counter.inc()
	}

	exporter := metrics.new_exporter(state.metrics_reg)
	output := exporter.export()

	state.logger.info('Prometheus metrics:\n${output}')
}

// ═══════════════════════════════════════════════════════════════════════════
// Main Entry Point
// ═══════════════════════════════════════════════════════════════════════════

fn main() {
	println('╔══════════════════════════════════════════════════════════════════════════╗')
	println('║                                                                          ║')
	println('║          🚀 VModu Runtime v3.0 - Production Ready Implementation         ║')
	println('║              With Improved Modules (Race-Free, High Performance)         ║')
	println('║                                                                          ║')
	println('╚══════════════════════════════════════════════════════════════════════════╝')
	println('')

	// Initialize system
	mut state := init_system() or {
		eprintln('Failed to initialize system: ${err}')
		exit(1)
	}

	// Run demos
	println('')
	println('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━')
	println('🎬 Running Feature Demonstrations')
	println('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━')
	println('')

	demo_event_bus(mut state)
	println('')
	demo_event_store(mut state)
	println('')
	demo_circuit_breaker(mut state)
	println('')
	demo_metrics_export(state)

	// Health report
	println('')
	println('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━')
	println('🏥 Health Status')
	println('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━')

	report := state.health_check.get_report()
	println('Overall Status: ${report.status}')
	for component in report.components {
		println('  • ${component.name}: ${component.status} - ${component.message}')
	}

	// Graceful shutdown
	println('')
	println('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━')
	println('🛑 System Shutdown')
	println('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━')

	shutdown_system(mut state)

	println('')
	println('╔══════════════════════════════════════════════════════════════════════════╗')
	println('║                                                                          ║')
	println('║                   ✅ All Improvements Successfully Integrated             ║')
	println('║                                                                          ║')
	println('╚══════════════════════════════════════════════════════════════════════════╝')
}
